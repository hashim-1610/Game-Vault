# Copy this file to secrets.toml (same folder) for local dev, and paste the
# same key into your app's "Secrets" section in Streamlit Community Cloud
# settings for deployment. NEVER commit a filled-in secrets.toml to git —
# add ".streamlit/secrets.toml" to your .gitignore.

DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
